NODE_ENV=development
PORT=3000
APP_NAME=sso-vietprodev
APP_GLOBAL_PREFIX=
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
SESSION_SECRET=change-me-session-secret-at-least-32-chars
COOKIE_SECURE=false

SSO_LOGIN_PRIMARY_URL=postgresql://sso_app_user:password@localhost:6432/sso_login
SSO_LOGIN_BACKUP_URL=postgresql://sso_app_user:password@localhost:6432/sso_login
PROJECT_A_DATABASE_URL=postgresql://project_user:password@localhost:5432/project_a
PROJECT_B_DATABASE_URL=postgresql://project_user:password@localhost:5432/project_b
MONGODB_AUDIT_URL=mongodb://localhost:27017/sso_audit
MONGODB_AUDIT_DATABASE=sso_audit

OIDC_ISSUER=http://localhost:3000
OIDC_ACCESS_TOKEN_TTL=900
OIDC_REFRESH_TOKEN_TTL=2592000
OIDC_PRIVATE_JWK_PATH=./secrets/oidc-private.jwk.json
OIDC_PUBLIC_JWKS_PATH=./secrets/oidc-jwks.json
OIDC_COOKIE_KEYS=dev-cookie-key-1,dev-cookie-key-2

ADMIN_API_KEY=change-me-admin-api-key
BACKUP_VERIFY_CRON=*/5 * * * *
DB_HEALTH_CRON=*/30 * * * * *
AUDIT_CLEANUP_CRON=0 3 * * *
AUDIT_RETENTION_DAYS=365
HAPROXY_STATS_URL=http://localhost:8404/stats;csv
PATRONI_API_URL=http://localhost:8008
PGBOUNCER_DATABASE_URL=postgresql://sso_app_user:password@localhost:6432/pgbouncer

# Security Configuration
SSO_RATE_LIMIT_ENABLED=true
SSO_RATE_LIMIT_TTL=60000
SSO_RATE_LIMIT_LOGIN_LIMIT=10
SSO_RATE_LIMIT_TOKEN_LIMIT=30
SSO_RATE_LIMIT_SHORT_LIMIT=20
SSO_BRUTE_FORCE_LOCKOUT_THRESHOLD=5
SSO_BRUTE_FORCE_LOCKOUT_DURATION_MINUTES=15
